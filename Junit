@Test
void testSignedAreaAndOrientation() {
List<List<Double>> square = new ArrayList<>();
square.add(List.of(0.0, 0.0));
square.add(List.of(1.0, 0.0));
square.add(List.of(1.0, 1.0));
square.add(List.of(0.0, 1.0));
square.add(List.of(0.0, 0.0));


double area = Main.signedArea(square);
assertTrue(area > 0, "Area should be positive for CCW");


List<List<Double>> ccw = Main.orientCCW(square);
assertTrue(Main.signedArea(ccw) > 0, "CCW orientation should have positive area");


List<List<Double>> cw = Main.orientCW(square);
assertTrue(Main.signedArea(cw) < 0, "CW orientation should have negative area");
}


