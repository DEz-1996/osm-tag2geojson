}


@Test
void testSaveGeojson() throws IOException {
List<Map<String, Object>> features = new ArrayList<>();
Map<String, Object> feat = new HashMap<>();
feat.put("id", 123L);
feat.put("geometry", Map.of("type", "Point", "coordinates", List.of(30.0, 50.0)));
feat.put("props", Map.of("name", "Test Point"));
features.add(feat);


Path out = Files.createTempFile("geojson_test", ".geojson");
Main.saveGeojson(features, out);


String content = Files.readString(out);
assertTrue(content.contains("FeatureCollection"));
assertTrue(content.contains("Test Point"));
assertTrue(content.contains("123"));


// Перевірка, що JSON можна розпарсити
ObjectMapper mapper = new ObjectMapper();
Map parsed = mapper.readValue(content, Map.class);
assertEquals("FeatureCollection", parsed.get("type"));
List feats = (List) parsed.get("features");
assertEquals(1, feats.size());
}


@Test
void testReverse() {
List<List<Double>> coords = new ArrayList<>();
coords.add(List.of(0.0, 0.0));
coords.add(List.of(1.0, 0.0));
coords.add(List.of(2.0, 0.0));


List<List<Double>> reversed = Main.reverse(coords);
assertEquals(List.of(2.0, 0.0), reversed.get(0));
assertEquals(List.of(0.0, 0.0), reversed.get(2));
}
}
